// Shared GPU-postproc body for the RealESRGAN host.
//
// Reads the network's planar RGB output (cstep-strided channels) and writes
// packed RGBA8 bytes. When tw/th (presentation target) are smaller than the
// network output, the shader performs an exact area average (box filter with
// fractional edge weights) per axis BEFORE the download, so the host ships
// only target-size bytes instead of the full 4x frame. Rounding matches the
// reference implementation (x * 255 + 0.5, floor, clamp); the identity path
// (tw == w && th == h) is bit-identical to the previous shader.
//
// Included by realesrgan_spike_postproc.comp (CHANNEL_TYPE=float16_t) and
// realesrgan_spike_postproc_f32.comp (CHANNEL_TYPE=float); the only difference
// is the source channel type. CHANNEL_TYPE is supplied by the build
// (-DCHANNEL_TYPE=...) together with the -I include path.
layout (constant_id = 0) const int bgr = 0;

layout (binding = 0) readonly buffer bottom_blob { CHANNEL_TYPE bottom_blob_data[]; };
layout (binding = 1) writeonly buffer top_blob { uint top_blob_data[]; };

layout (push_constant) uniform parameter
{
    int w;    // network output width  (4x input)
    int h;    // network output height
    int cstep;
    int tw;   // presentation target width  (<= w: box downscale on this axis)
    int th;   // presentation target height (<= h: box downscale on this axis)
} p;

// Byte-domain tap: clamp to [0,1], scale to 0..255 and quantize exactly like
// the identity path. Shared by the box (downscale) and bilinear (upscale)
// branches so every path quantizes its taps the same way. float(...) is the
// fp32 no-op and the fp16 widening cast, so one body serves both precisions.
float tap(int c, int x, int y)
{
    return floor(clamp(float(bottom_blob_data[c * p.cstep + y * p.w + x]) * 255.0 + 0.5, 0.0, 255.0));
}

void main()
{
    const int gx = int(gl_GlobalInvocationID.x);
    const int gy = int(gl_GlobalInvocationID.y);

    if (gx >= p.tw || gy >= p.th)
        return;

    // r/g/b are kept in BYTE domain [0,255] on every path so the final
    // rounding below is the only quantization after any averaging.
    float r;
    float g;
    float b;

    if (p.tw == p.w && p.th == p.h)
    {
        // Identity: one tap, quantized exactly like the original shader.
        r = tap(0, gx, gy);
        g = tap(1, gx, gy);
        b = tap(2, gx, gy);
    }
    else if (p.tw > p.w || p.th > p.h)
    {
        // Bilinear upscale: a presentation target larger than the network
        // output. Only reachable when the host reduced the inference scale
        // (fp32 governor); sampled at pixel centres with clamped edges.
        const float sx = (float(gx) + 0.5) * float(p.w) / float(p.tw) - 0.5;
        const float sy = (float(gy) + 0.5) * float(p.h) / float(p.th) - 0.5;
        const int fx0 = int(floor(sx));
        const int fy0 = int(floor(sy));
        const float ax = sx - float(fx0);
        const float ay = sy - float(fy0);
        const int x0 = clamp(fx0, 0, p.w - 1);
        const int x1 = clamp(fx0 + 1, 0, p.w - 1);
        const int y0 = clamp(fy0, 0, p.h - 1);
        const int y1 = clamp(fy0 + 1, 0, p.h - 1);
        const float t00r = tap(0, x0, y0), t01r = tap(0, x1, y0);
        const float t10r = tap(0, x0, y1), t11r = tap(0, x1, y1);
        const float t00g = tap(1, x0, y0), t01g = tap(1, x1, y0);
        const float t10g = tap(1, x0, y1), t11g = tap(1, x1, y1);
        const float t00b = tap(2, x0, y0), t01b = tap(2, x1, y0);
        const float t10b = tap(2, x0, y1), t11b = tap(2, x1, y1);
        r = mix(mix(t00r, t01r, ax), mix(t10r, t11r, ax), ay);
        g = mix(mix(t00g, t01g, ax), mix(t10g, t11g, ax), ay);
        b = mix(mix(t00b, t01b, ax), mix(t10b, t11b, ax), ay);
    }
    else
    {
        // Exact box filter. Source footprint of output pixel gx on the x
        // axis is [gx*w/tw, (gx+1)*w/tw); each covered source pixel
        // contributes its overlap length.
        //
        // Byte-domain averaging: each tap is quantized EXACTLY like the
        // identity path BEFORE accumulating, and the final average rounds
        // once. This matches (a) the tiled CPU downscale pass in the host
        // and (b) the browser presentation sampler, which area-averages the
        // already-quantized rgba8 texture. Averaging the raw fp16 values
        // instead would quantize only once (marginally cleaner) but diverge
        // from all three existing consumers at network-overshoot pixels.
        // An axis whose target is >= the source falls back to a single
        // identity tap so mixed cases (one axis downscaled, one not) stay
        // deterministic.
        float x0f = (float(gx) * float(p.w)) / float(p.tw);
        float x1f = (float(gx + 1) * float(p.w)) / float(p.tw);
        float y0f = (float(gy) * float(p.h)) / float(p.th);
        float y1f = (float(gy + 1) * float(p.h)) / float(p.th);
        if (p.tw >= p.w) { x0f = float(gx); x1f = x0f + 1.0; }
        if (p.th >= p.h) { y0f = float(gy); y1f = y0f + 1.0; }
        const int x0 = int(floor(x0f));
        const int x1 = int(ceil(x1f));
        const int y0 = int(floor(y0f));
        const int y1 = int(ceil(y1f));
        float ar = 0.0;
        float ag = 0.0;
        float ab = 0.0;
        float wsum = 0.0;
        for (int y = y0; y < y1; ++y)
        {
            const float wy = min(y1f, float(y + 1)) - max(y0f, float(y));
            if (wy <= 0.0)
                continue;
            const int row = y * p.w;
            for (int x = x0; x < x1; ++x)
            {
                const float wx = min(x1f, float(x + 1)) - max(x0f, float(x));
                if (wx <= 0.0)
                    continue;
                const float wgt = wx * wy;
                ar += floor(clamp(float(bottom_blob_data[0 * p.cstep + row + x]) * 255.0 + 0.5, 0.0, 255.0)) * wgt;
                ag += floor(clamp(float(bottom_blob_data[1 * p.cstep + row + x]) * 255.0 + 0.5, 0.0, 255.0)) * wgt;
                ab += floor(clamp(float(bottom_blob_data[2 * p.cstep + row + x]) * 255.0 + 0.5, 0.0, 255.0)) * wgt;
                wsum += wgt;
            }
        }
        const float inv = 1.0 / max(wsum, 1e-6);
        r = ar * inv;
        g = ag * inv;
        b = ab * inv;
    }

    // Single final round (identity values are exact integers, so this is a
    // no-op there and the output stays bit-identical to the original shader).
    // bgr flag mirrors the reference preproc convention (0 on non-Windows).
    uint ur = clamp(uint(floor(r + 0.5f)), 0u, 255u);
    uint ug = clamp(uint(floor(g + 0.5f)), 0u, 255u);
    uint ub = clamp(uint(floor(b + 0.5f)), 0u, 255u);
    if (bgr == 1)
    {
        uint t = ur; ur = ub; ub = t;
    }

    top_blob_data[gy * p.tw + gx] = (ub << 16) | (ug << 8) | (ur << 0) | 0xFF000000u;
}
