#version 450
#extension GL_EXT_shader_16bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require

// GPU preproc for RealESRGAN: RGBA8 interleaved -> planar fp16 RGB [0,1]
// Inverse of postproc: replaces CPU scalar loop + CPU f32->f16 cast.
layout (constant_id = 0) const int bgr = 0;

layout (binding = 0) readonly buffer bottom_blob { uint bottom_blob_data[]; };
layout (binding = 1) writeonly buffer top_blob { float16_t top_blob_data[]; };

layout (push_constant) uniform parameter
{
    int w;
    int h;
    int cstep;
} p;

void main()
{
    const int gx = int(gl_GlobalInvocationID.x);
    const int gy = int(gl_GlobalInvocationID.y);
    if (gx >= p.w || gy >= p.h)
        return;
    const int idx = gy * p.w + gx;
    const uint rgba = bottom_blob_data[idx];
    // rgba is little-endian: R in bits 0..7, G 8..15, B 16..23, A 24..31
    uint r_u = (rgba >> 0)  & 0xFFu;
    uint g_u = (rgba >> 8)  & 0xFFu;
    uint b_u = (rgba >> 16) & 0xFFu;
    if (bgr == 1)
    {
        uint t = r_u; r_u = b_u; b_u = t;
    }
    const float scale = 1.0f / 255.0f;
    float16_t r = float16_t(float(r_u) * scale);
    float16_t g = float16_t(float(g_u) * scale);
    float16_t b = float16_t(float(b_u) * scale);
    top_blob_data[0 * p.cstep + idx] = r;
    top_blob_data[1 * p.cstep + idx] = g;
    top_blob_data[2 * p.cstep + idx] = b;
}
