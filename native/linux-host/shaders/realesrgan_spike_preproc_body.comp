// Shared GPU-preproc body for the RealESRGAN host.
//
// RGBA8 interleaved -> planar RGB [0,1]. Included by both
// realesrgan_spike_preproc.comp (CHANNEL_TYPE=float16_t) and
// realesrgan_spike_preproc_f32.comp (CHANNEL_TYPE=float); the only difference
// between the two is the destination channel type. CHANNEL_TYPE is supplied
// by the build (-DCHANNEL_TYPE=...) together with the -I include path.
layout (constant_id = 0) const int bgr = 0;

layout (binding = 0) readonly buffer bottom_blob { uint bottom_blob_data[]; };
layout (binding = 1) writeonly buffer top_blob { CHANNEL_TYPE top_blob_data[]; };

layout (push_constant) uniform parameter
{
    int w;
    int h;
    int cstep;
} p;

void main()
{
    const int gx = int(gl_GlobalInvocationID.x);
    const int gy = int(gl_GlobalInvocationID.y);
    if (gx >= p.w || gy >= p.h)
        return;
    const int idx = gy * p.w + gx;
    const uint rgba = bottom_blob_data[idx];
    // rgba is little-endian: R in bits 0..7, G 8..15, B 16..23, A 24..31
    uint r_u = (rgba >> 0)  & 0xFFu;
    uint g_u = (rgba >> 8)  & 0xFFu;
    uint b_u = (rgba >> 16) & 0xFFu;
    if (bgr == 1)
    {
        uint t = r_u; r_u = b_u; b_u = t;
    }
    const float scale = 1.0f / 255.0f;
    top_blob_data[0 * p.cstep + idx] = CHANNEL_TYPE(float(r_u) * scale);
    top_blob_data[1 * p.cstep + idx] = CHANNEL_TYPE(float(g_u) * scale);
    top_blob_data[2 * p.cstep + idx] = CHANNEL_TYPE(float(b_u) * scale);
}
