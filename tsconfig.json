{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["node_modules", "native/**/build", ".tmp", "tests/bench"]
}
