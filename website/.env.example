# Server
PORT=4242
PUBLIC_URL=http://localhost:4242

# Stripe — use test values locally and live values only in production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_1TtXoqRwCRtqHp9HMTfPsp1Q
STRIPE_PRICE_PRO_YEARLY=price_1TtXorRwCRtqHp9HePOqOzuH
STRIPE_PRICE_LIFETIME=price_1TtXosRwCRtqHp9H0sx9v0C1
STRIPE_PORTAL_CONFIGURATION_ID=bpc_1TtZB1RwCRtqHp9HyJf1PMNh
STRIPE_AUTOMATIC_TAX=false
# Keep this false until the test secret, webhook secret, database URL, and stable license key are set.
PAID_ENTITLEMENTS_ENABLED=false

# Neon project twilight-flower-58972462. Keep DATABASE_URL server-side only.
DATABASE_URL=postgresql://replace_with_neon_connection_string
NEON_AUTH_URL=https://ep-orange-lake-ajqnw0vw.neonauth.c-3.us-east-2.aws.neon.tech/neondb/auth
# Separate keyed-HMAC secret for pseudonymising rate-limit identifiers.
PRIVACY_HASH_KEY_B64=
# Dedicated bearer token for the aggregate operations-status endpoint.
OPERATIONS_MONITOR_TOKEN=

# Run `npm run generate:license-key` once and store the generated value securely.
LICENSE_PRIVATE_KEY_PKCS8_B64=replace_with_generated_base64_pkcs8
LICENSE_AUDIENCE=aniwebscale-extension

# Prices shown on the page. Keep these in sync with the Stripe Prices above.
PUBLIC_PRICE_MONTHLY=4.99
PUBLIC_PRICE_YEARLY=41.99
PUBLIC_PRICE_LIFETIME=59.99
PUBLIC_CURRENCY=$

# Extension and account links
CHROME_STORE_URL=
FIREFOX_ADDONS_URL=
GITHUB_REPO_URL=

# Public operator details used by the legal pages.
LEGAL_NAME=Korrespont GbR
LEGAL_EMAIL=support@korrespont.com
LEGAL_ADDRESS=Paterkamp 11a, 59348 Lüdinghausen, Deutschland
LEGAL_REPRESENTATIVES=Karim Mahmoudi and Daniel Nikoulchine
LEGAL_VAT_ID=
LEGAL_PHONE=
LEGAL_REGISTER_COURT=
LEGAL_REGISTER_NUMBER=
# Required wording depends on whether regular VAT or the Kleinunternehmer rule applies.
LEGAL_TAX_NOTICE=
LEGAL_VERSION=2026-07-17
# Keep these false until the named qualified reviewer has approved the exact deployed version.
LEGAL_REVIEW_APPROVED=false
TAX_CONFIGURATION_APPROVED=false
# Set true only after AV contracts, subprocessors, processing regions, transfer safeguards,
# retention periods, the records of processing, TOMs and the data-subject process are verified.
DATA_PROTECTION_APPROVED=false
# Public, reviewer-confirmed retention/transfer facts. These are required before approval.
PRIVACY_CLOUDFLARE_LOG_RETENTION_DAYS=
PRIVACY_NEON_PITR_RETENTION_DAYS=
PRIVACY_AUTH_SESSION_RETENTION_DAYS=
PRIVACY_VENDOR_REVIEW_DATE=
PRIVACY_TRANSFER_SAFEGUARDS=

# Local encrypted database backups. Generate 32 random bytes and store the base64 value securely.
BACKUP_ENCRYPTION_KEY_B64=
# Independent S3-compatible copy (for example Backblaze B2, AWS S3 or a
# separately administered R2 account). The upload is mandatory in backup CI.
BACKUP_SECONDARY_S3_ENDPOINT=https://s3.example.com
BACKUP_SECONDARY_S3_BUCKET=
BACKUP_SECONDARY_S3_REGION=auto
BACKUP_SECONDARY_S3_ACCESS_KEY_ID=
BACKUP_SECONDARY_S3_SECRET_ACCESS_KEY=
BACKUP_SECONDARY_S3_PREFIX=aniwebscale
# Restore only into an isolated database initialized with the current Neon Auth schema.
# GitHub Actions uses the equivalent RESTORE_DRILL_DATABASE_URL secret weekly.
RESTORE_DATABASE_URL=
CONFIRM_ISOLATED_RESTORE=no
