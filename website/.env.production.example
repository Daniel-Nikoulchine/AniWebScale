NODE_ENV=production
PORT=4242
PUBLIC_URL=https://your-domain.example

# Stripe live-mode values. Never commit the completed file.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me
STRIPE_PRICE_LIFETIME=price_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
STRIPE_AUTOMATIC_TAX=false
PAID_ENTITLEMENTS_ENABLED=false

# Server-only Neon connection and public Neon Auth endpoint.
DATABASE_URL=postgresql://replace_with_neon_connection_string
NEON_AUTH_URL=https://your-neon-auth-host.example/neondb/auth

# Generate once with `npm run generate:license-key` and retain across deploys.
LICENSE_PRIVATE_KEY_PKCS8_B64=replace_with_generated_base64_pkcs8
LICENSE_AUDIENCE=aniwebscale-extension

PUBLIC_PRICE_MONTHLY=4.99
PUBLIC_PRICE_YEARLY=41.99
PUBLIC_PRICE_LIFETIME=59.99
PUBLIC_CURRENCY=$

CHROME_STORE_URL=
FIREFOX_ADDONS_URL=
GITHUB_REPO_URL=

LEGAL_NAME=Korrespont GbR
LEGAL_EMAIL=support@korrespont.com
LEGAL_ADDRESS=Paterkamp 11a, 59348 Lüdinghausen, Deutschland
LEGAL_REPRESENTATIVES=Karim Mahmoudi and Daniel Nikoulchine
LEGAL_VAT_ID=
