{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "functions/**/*.js",
    "lib/**/*.mjs",
    "server.mjs",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    ".wrangler",
    "node_modules",
    "public"
  ]
}
