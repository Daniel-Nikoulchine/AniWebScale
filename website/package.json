{
  "name": "aniwebscale-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing site and Stripe Checkout server for AniWebScale.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "generate:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime false --env-file .env.example --strict-vars false",
    "backup:database": "node scripts/backup-database.mjs",
    "build:cloudflare": "npm run build:client && wrangler pages functions build --outdir=.wrangler/functions-build --minify --metafile --compatibility-date=2026-07-15 --compatibility-flags=nodejs_compat",
    "bootstrap:cloudflare": "node scripts/bootstrap-cloudflare.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-build.mjs",
    "check:live": "node scripts/check-live-deployment.mjs",
    "check:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime false --env-file .env.example --strict-vars false --check && tsc -p jsconfig.json",
    "cleanup:retention": "node scripts/cleanup-personal-data.mjs",
    "configure:stripe-webhook": "node scripts/configure-stripe-cloudflare-webhook.mjs",
    "deploy:cloudflare": "npm run build:client && wrangler pages deploy",
    "dev:cloudflare": "npm run build:client && wrangler pages dev",
    "generate:license-key": "node scripts/generate-license-key.mjs",
    "generate:privacy-key": "node scripts/generate-privacy-key.mjs",
    "generate:operations-token": "node scripts/generate-operations-token.mjs",
    "generate:backup-key": "node scripts/generate-backup-key.mjs",
    "migrate:database": "node scripts/migrate-database.mjs",
    "reconcile:deletions": "node scripts/reconcile-deletions.mjs",
    "restore:database": "node scripts/restore-database-backup.mjs",
    "download:backup:secondary": "node scripts/download-backup-copy.mjs",
    "validate:restore-drill": "node scripts/validate-restore-drill.mjs",
    "record:restore-drill": "node scripts/record-restore-drill-result.mjs",
    "predev": "npm run build:client",
    "dev": "node --watch server.mjs",
    "prestart": "npm run build:client",
    "start": "node server.mjs",
    "start:production": "npm run check:config && node server.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:cloudflare:local": "npm run build:client && node scripts/test-cloudflare-local.mjs",
    "test:database:integration": "node scripts/test-database-restore.mjs",
    "test:database:restore": "node scripts/test-database-restore-pglite.mjs",
    "check:operations": "node scripts/check-operational-status.mjs",
    "test:live:local": "node scripts/test-live-check-local.mjs",
    "test:e2e:sandbox": "node scripts/test-sandbox-e2e.mjs",
    "verify:backup": "node scripts/verify-database-backup.mjs",
    "upload:backup:secondary": "node scripts/upload-backup-copy.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "jose": "^6.2.3",
    "lucide-static": "^1.24.0",
    "pg": "^8.22.0",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.10.1",
    "@types/pg": "8.20.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.111.0"
  }
}
