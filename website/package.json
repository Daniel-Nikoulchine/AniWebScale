{
  "name": "aniwebscale-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing site for AniWebScale — fully free, static.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx --yes serve public",
    "start": "npx --yes serve public",
    "build:client": "esbuild client/site-localize.mjs --bundle --minify --format=iife --outfile=public/site-localize.js",
    "check:locales": "node scripts/check-locale-parity.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
